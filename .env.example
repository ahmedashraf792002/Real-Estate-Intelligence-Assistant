# Supabase -> Connect -> "Session pooler" connection string (works on IPv4 and on Hugging Face)
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# OpenRouter: main key + backup keys (used when the main key reaches its daily limit)
OPENROUTER_API_KEY=sk-or-v1-main-key
OPENROUTER_API_KEYS=sk-or-v1-backup-1,sk-or-v1-backup-2

# optional second provider, any OpenAI compatible api
# FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# FALLBACK_API_KEY=gsk_...
# FALLBACK_MODELS=llama-3.3-70b-versatile
